@page "/"
@model Sician_Diana_Lab2.Pages.Books.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Books</h1>

<form method="get" class="mb-3 d-flex gap-2">
    <select asp-for="AuthorID" asp-items="Model.AuthorsSelect" class="form-select" style="max-width:240px">
        <option value="">-- filter by author --</option>
    </select>
    <button type="submit" class="btn btn-primary">Filter</button>
    <a asp-page="./Index" class="btn btn-outline-secondary">Clear</a>
</form>

<p>
    <a asp-page="Create">Create New</a>
    <form asp-page="./Index" method="get">
        <div class="form-actions no-color">
            <p>
                Find by Book Title / Author Name:
                <input type="text" name="searchString" value="@Model.CurrentFilter" />
                <input type="submit" value="Search" class="btn btn-primary" /> |
                <a asp-page="./Index">Back to full List</a>
            </p>
        </div>
    </form>
</p>

<table class="table">
    <thead>
        <tr>
            <th>
                <a asp-page="./Index" asp-route-sortOrder="@Model.TitleSort">
                @Html.DisplayNameFor(m => m.Book[0].Title)
                </a>
                </th>
            <th>Author</th>
            <th>@Html.DisplayNameFor(m => m.Book[0].Price)</th>
            <th>@Html.DisplayNameFor(m => m.Book[0].PublishingDate)</th>
            <th>@Html.DisplayNameFor(m => m.Book[0].Publisher.PublisherName)</th>
            <a asp-page="./Index" asp-route-sortOrder="@Model.AuthorSort">
            <th>@Html.DisplayNameFor(m => m.Book[0].Author)</th>
            </a>
            <th>
                @Html.DisplayNameFor(model => model.Book[0].BookCategories)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.BookD.Books)
        {
            // verific dacă această carte este cea selectată și schimb culoarea rândului
            string selectedRow = "";
            if (item.ID == Model.BookID)
            {
                selectedRow = "table-success"; // evidențiez cartea selectată
            }

            <tr class="@selectedRow">
                <td>
                    @Html.DisplayFor(modelItem => item.Title)
                </td>
                 
                <td>@($"{item.Author.FirstName} {item.Author.LastName}")</td>
                

                
                <td>
                    @Html.DisplayFor(modelItem => item.Price)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.PublishingDate)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Publisher.PublisherName)
                </td>
                <td>
                    <!-- afișez categoriile fiecărei cărți -->
                    @foreach (var category in item.BookCategories)
                    {
                        <!-- fiecare categorie devine link pentru filtrare -->
                        <a asp-page="./Index"
                           asp-route-id="@item.ID"
                           asp-route-categoryID="@category.Category.ID">
                            @category.Category.CategoryName
                        </a>
                        <br />
                    }
                </td>
                <td>
                    <a asp-page="./Edit" asp-route-id="@item.ID">Edit</a> |
                    <a asp-page="./Details" asp-route-id="@item.ID">Details</a> |
                    <a asp-page="./Delete" asp-route-id="@item.ID">Delete</a>
                </td>
            </tr>
        }
    </tbody>

</table>
